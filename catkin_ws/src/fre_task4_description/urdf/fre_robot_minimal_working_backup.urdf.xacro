<?xml version="1.0"?>
<robot name="fre_robot_minimal" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ===================== -->
  <!-- Basic dimensions       -->
  <!-- ===================== -->
  <xacro:property name="base_length" value="0.90"/>
  <xacro:property name="base_width"  value="0.70"/>
  <xacro:property name="base_height" value="0.35"/>

  <xacro:property name="wheel_radius" value="0.12"/>
  <xacro:property name="wheel_width"  value="0.06"/>

  <xacro:property name="wheel_x_front" value="0.32"/>
  <xacro:property name="wheel_x_rear"  value="-0.32"/>
  <xacro:property name="wheel_y_left"  value="0.38"/>
  <xacro:property name="wheel_y_right" value="-0.38"/>
  <xacro:property name="wheel_z"       value="-0.155"/>

  <!-- base_link center is 0.275 m above ground.
       wheel center is at 0.275 - 0.155 = 0.120 m.
       wheel radius is 0.120 m, so wheels touch the ground. -->

  <!-- ===================== -->
  <!-- Materials              -->
  <!-- ===================== -->
  <material name="dark_gray">
    <color rgba="0.15 0.15 0.15 1.0"/>
  </material>

  <material name="black">
    <color rgba="0.02 0.02 0.02 1.0"/>
  </material>

  <material name="blue">
    <color rgba="0.0 0.2 1.0 1.0"/>
  </material>

  <material name="green">
    <color rgba="0.0 0.8 0.2 1.0"/>
  </material>

  <material name="yellow">
    <color rgba="1.0 0.8 0.0 1.0"/>
  </material>

  <material name="red">
    <color rgba="1.0 0.0 0.0 1.0"/>
  </material>

  <!-- ===================== -->
  <!-- Macro: 4WS wheel unit  -->
  <!-- ===================== -->
  <xacro:macro name="steered_wheel" params="prefix x y z">

    <!-- Steering carrier. This is the part that turns around the vertical Z axis. -->
    <link name="${prefix}_steering_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.045" length="0.06"/>
        </geometry>
        <material name="dark_gray"/>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.045" length="0.06"/>
        </geometry>
      </collision>

      <inertial>
        <origin xyz="0 0 0"/>
        <mass value="0.5"/>
        <inertia ixx="0.005" ixy="0" ixz="0"
                 iyy="0.005" iyz="0"
                 izz="0.005"/>
      </inertial>
    </link>

    <joint name="${prefix}_steering_joint" type="revolute">
      <parent link="base_link"/>
      <child link="${prefix}_steering_link"/>
      <origin xyz="${x} ${y} ${z}" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="-0.785" upper="0.785" effort="50.0" velocity="2.0"/>
    </joint>

    <!-- Wheel. This rotates around the local Y axis. -->
    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="black"/>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>

      <inertial>
        <origin xyz="0 0 0"/>
        <mass value="1.0"/>
        <inertia ixx="0.01" ixy="0" ixz="0"
                 iyy="0.01" iyz="0"
                 izz="0.01"/>
      </inertial>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="${prefix}_steering_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>

    <gazebo reference="${prefix}_steering_link">
      <material>Gazebo/DarkGrey</material>
    </gazebo>

    <gazebo reference="${prefix}_wheel_link">
      <material>Gazebo/Black</material>
      <mu1>5.0</mu1>
      <mu2>5.0</mu2>
      <kp>1000000.0</kp>
      <kd>10.0</kd>
    </gazebo>

  </xacro:macro>

  <!-- ===================== -->
  <!-- base_footprint         -->
  <!-- ===================== -->
  <link name="base_footprint"/>

  <joint name="base_footprint_to_base_link" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.275" rpy="0 0 0"/>
  </joint>

  <!-- ===================== -->
  <!-- base_link              -->
  <!-- ===================== -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="25.0"/>
      <inertia ixx="1.5" ixy="0" ixz="0"
               iyy="1.5" iyz="0"
               izz="1.5"/>
    </inertial>
  </link>

  <!-- ===================== -->
  <!-- Four steered wheels    -->
  <!-- ===================== -->
  <xacro:steered_wheel prefix="front_left"  x="${wheel_x_front}" y="${wheel_y_left}"  z="${wheel_z}"/>
  <xacro:steered_wheel prefix="front_right" x="${wheel_x_front}" y="${wheel_y_right}" z="${wheel_z}"/>
  <xacro:steered_wheel prefix="rear_left"   x="${wheel_x_rear}"  y="${wheel_y_left}"  z="${wheel_z}"/>
  <xacro:steered_wheel prefix="rear_right"  x="${wheel_x_rear}"  y="${wheel_y_right}" z="${wheel_z}"/>

  <!-- ===================== -->
  <!-- lidar                  -->
  <!-- ===================== -->
  <link name="lidar_link">
    <visual>
      <geometry>
        <cylinder radius="0.05" length="0.06"/>
      </geometry>
      <material name="blue"/>
    </visual>

    <collision>
      <geometry>
        <cylinder radius="0.05" length="0.06"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.001" ixy="0" ixz="0"
               iyy="0.001" iyz="0"
               izz="0.001"/>
    </inertial>
  </link>

  <joint name="base_link_to_lidar" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.32 0 0.25" rpy="0 0 0"/>
  </joint>

  <!-- ===================== -->
  <!-- front depth camera     -->
  <!-- ===================== -->
  <link name="front_camera_link">
    <visual>
      <geometry>
        <box size="0.08 0.03 0.03"/>
      </geometry>
      <material name="green"/>
    </visual>

    <collision>
      <geometry>
        <box size="0.08 0.03 0.03"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.0005" ixy="0" ixz="0"
               iyy="0.0005" iyz="0"
               izz="0.0005"/>
    </inertial>
  </link>

  <joint name="base_link_to_front_camera" type="fixed">
    <parent link="base_link"/>
    <child link="front_camera_link"/>
    <origin xyz="0.43 0 0.10" rpy="0 0 0"/>
  </joint>

  <link name="front_camera_optical_frame"/>

  <joint name="front_camera_to_optical" type="fixed">
    <parent link="front_camera_link"/>
    <child link="front_camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>

  <!-- ===================== -->
  <!-- downward depth camera  -->
  <!-- ===================== -->
  <link name="down_camera_link">
    <visual>
      <geometry>
        <box size="0.08 0.03 0.03"/>
      </geometry>
      <material name="yellow"/>
    </visual>

    <collision>
      <geometry>
        <box size="0.08 0.03 0.03"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.0005" ixy="0" ixz="0"
               iyy="0.0005" iyz="0"
               izz="0.0005"/>
    </inertial>
  </link>

  <joint name="base_link_to_down_camera" type="fixed">
    <parent link="base_link"/>
    <child link="down_camera_link"/>
    <origin xyz="0.15 0 0.05" rpy="0 1.5708 0"/>
  </joint>

  <link name="down_camera_optical_frame"/>

  <joint name="down_camera_to_optical" type="fixed">
    <parent link="down_camera_link"/>
    <child link="down_camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>

  <!-- ===================== -->
  <!-- treatment tool/nozzle  -->
  <!-- ===================== -->
  <link name="treatment_tool_link">
    <visual>
      <geometry>
        <cylinder radius="0.025" length="0.12"/>
      </geometry>
      <material name="red"/>
    </visual>

    <collision>
      <geometry>
        <cylinder radius="0.025" length="0.12"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.0005" ixy="0" ixz="0"
               iyy="0.0005" iyz="0"
               izz="0.0005"/>
    </inertial>
  </link>

  <joint name="base_link_to_treatment_tool" type="fixed">
    <parent link="base_link"/>
    <child link="treatment_tool_link"/>
    <origin xyz="-0.10 0 -0.12" rpy="0 0 0"/>
  </joint>

  <!-- ===================== -->
  <!-- Gazebo materials       -->
  <!-- ===================== -->
  <gazebo reference="base_link">
    <material>Gazebo/DarkGrey</material>
  </gazebo>

  <gazebo reference="lidar_link">
    <material>Gazebo/Blue</material>
  </gazebo>

  <gazebo reference="front_camera_link">
    <material>Gazebo/Green</material>
  </gazebo>

  <gazebo reference="down_camera_link">
    <material>Gazebo/Yellow</material>
  </gazebo>

  <gazebo reference="treatment_tool_link">
    <material>Gazebo/Red</material>
  </gazebo>

  <!-- ===================== -->
  <!-- Simple planar movement -->
  <!-- ===================== -->
  <!-- This is not a real 4-wheel-steering controller.
       It is a simple /cmd_vel movement plugin used for local simulation.
       The robot has a 4WS-style TF/visual structure, while motion stays simple
       and stable for mapping/localization tests. -->
  <gazebo>
    <plugin name="fre_planar_move" filename="libgazebo_ros_planar_move.so">
      <commandTopic>cmd_vel</commandTopic>
      <odometryTopic>odom</odometryTopic>
      <odometryFrame>odom</odometryFrame>
      <robotBaseFrame>base_footprint</robotBaseFrame>
      <publishOdomTF>true</publishOdomTF>
      <publishOdometryTf>true</publishOdometryTf>
      <updateRate>50.0</updateRate>
    </plugin>
  </gazebo>

</robot>