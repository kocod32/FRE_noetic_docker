<?xml version="1.0"?>
<robot name="Farmbeast" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Self-contained version: no velodyne_description dependency, no external inertial macro dependency. -->
  <xacro:property name="pi" value="3.141592653589793"/>

  <!-- Basic inertial macros -->
  <xacro:macro name="inertial_box" params="mass x y z *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${mass}"/>
      <inertia
        ixx="${mass * (y*y + z*z) / 12.0}"
        ixy="0.0"
        ixz="0.0"
        iyy="${mass * (x*x + z*z) / 12.0}"
        iyz="0.0"
        izz="${mass * (x*x + y*y) / 12.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="inertial_cylinder" params="mass radius length *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${mass}"/>
      <inertia
        ixx="${mass * (3.0*radius*radius + length*length) / 12.0}"
        ixy="0.0"
        ixz="0.0"
        iyy="${mass * (3.0*radius*radius + length*length) / 12.0}"
        iyz="0.0"
        izz="${mass * radius*radius / 2.0}"/>
    </inertial>
  </xacro:macro>

  <!-- Materials -->
  <material name="white"><color rgba="1 1 1 1"/></material>
  <material name="orange"><color rgba="1 0.45 0.0 1"/></material>
  <material name="blue"><color rgba="0.05 0.05 1 1"/></material>
  <material name="black"><color rgba="0 0 0 1"/></material>
  <material name="grey"><color rgba="0.5 0.5 0.5 1"/></material>

  <!-- Dimensions -->
  <xacro:property name="chassis_x" value="0.55"/>
  <xacro:property name="chassis_y" value="0.42"/>
  <xacro:property name="chassis_z" value="0.24"/>
  <xacro:property name="chassis_center_z" value="0.24"/>

  <xacro:property name="wheel_radius" value="0.10"/>
  <xacro:property name="wheel_width" value="0.045"/>
  <xacro:property name="wheel_z" value="0.10"/>
  <xacro:property name="wheel_x_front" value="0.22"/>
  <xacro:property name="wheel_x_back" value="-0.22"/>
  <xacro:property name="steer_y_left" value="0.28"/>
  <xacro:property name="steer_y_right" value="-0.28"/>
  <xacro:property name="wheel_side_offset" value="0.07"/>

  <xacro:property name="steer_radius" value="0.025"/>
  <xacro:property name="steer_length" value="0.12"/>

  <!-- base_link is the ground/robot reference frame. Spawn with -z 0.0 or slightly above, e.g. 0.03. -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.001"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>

  <!-- Chassis -->
  <joint name="chassis_joint" type="fixed">
    <parent link="base_link"/>
    <child link="chassis"/>
    <origin xyz="0 0 ${chassis_center_z}" rpy="0 0 0"/>
  </joint>

  <link name="chassis">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="${chassis_x} ${chassis_y} ${chassis_z}"/></geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="${chassis_x} ${chassis_y} ${chassis_z}"/></geometry>
    </collision>
    <xacro:inertial_box mass="5.0" x="${chassis_x}" y="${chassis_y}" z="${chassis_z}">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:inertial_box>
  </link>

  <gazebo reference="chassis"><material>Gazebo/White</material></gazebo>

  <!-- Reusable steering + wheel module -->
  <xacro:macro name="steer_wheel" params="prefix x y side_sign">
    <joint name="${prefix}_z_axis_joint" type="revolute">
      <parent link="base_link"/>
      <child link="${prefix}_z_axis"/>
      <origin xyz="${x} ${y} ${wheel_z}" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="-1.57" upper="1.57" effort="20" velocity="5"/>
      <dynamics damping="0.05" friction="0.02"/>
    </joint>

    <link name="${prefix}_z_axis">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><cylinder radius="${steer_radius}" length="${steer_length}"/></geometry>
        <material name="orange"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><cylinder radius="${steer_radius}" length="${steer_length}"/></geometry>
      </collision>
      <xacro:inertial_cylinder mass="0.15" length="${steer_length}" radius="${steer_radius}">
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </xacro:inertial_cylinder>
    </link>

    <transmission name="${prefix}_z_axis_trans">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="${prefix}_z_axis_joint">
        <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      </joint>
      <actuator name="${prefix}_z_axis_actuator">
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>

    <gazebo reference="${prefix}_z_axis">
      <material>Gazebo/Orange</material>
    </gazebo>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="${prefix}_z_axis"/>
      <child link="${prefix}_wheel"/>
      <!-- Wheel link frame sits at wheel centre. Cylinder is rotated so its axle is along robot Y. -->
      <origin xyz="0 ${side_sign * wheel_side_offset} 0" rpy="-${pi/2} 0 0"/>
      <axis xyz="0 0 1"/>
      <dynamics damping="0.02" friction="0.01"/>
    </joint>

    <link name="${prefix}_wheel">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="blue"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <xacro:inertial_cylinder mass="0.25" length="${wheel_width}" radius="${wheel_radius}">
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </xacro:inertial_cylinder>
    </link>

    <transmission name="${prefix}_wheel_trans">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="${prefix}_wheel_joint">
        <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
      </joint>
      <actuator name="${prefix}_wheel_actuator">
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>

    <gazebo reference="${prefix}_wheel">
      <material>Gazebo/Blue</material>
      <mu1>2.0</mu1>
      <mu2>2.0</mu2>
      <kp>1000000.0</kp>
      <kd>10.0</kd>
    </gazebo>
  </xacro:macro>

  <xacro:steer_wheel prefix="left_front"  x="${wheel_x_front}" y="${steer_y_left}"  side_sign="1"/>
  <xacro:steer_wheel prefix="left_back"   x="${wheel_x_back}"  y="${steer_y_left}"  side_sign="1"/>
  <xacro:steer_wheel prefix="right_front" x="${wheel_x_front}" y="${steer_y_right}" side_sign="-1"/>
  <xacro:steer_wheel prefix="right_back"  x="${wheel_x_back}"  y="${steer_y_right}" side_sign="-1"/>

  <!-- Simple lidar placeholder. Keeps model self-contained. Replace later with VLP-16 when dependency is installed. -->
  <joint name="lidar_joint" type="fixed">
    <parent link="chassis"/>
    <child link="lidar_link"/>
    <origin xyz="0.12 0 0.145" rpy="0 0 0"/>
  </joint>

  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.055" length="0.04"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.055" length="0.04"/></geometry>
    </collision>
    <xacro:inertial_cylinder mass="0.3" length="0.04" radius="0.055">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:inertial_cylinder>
  </link>

  <gazebo reference="lidar_link">
    <material>Gazebo/DarkGrey</material>
  </gazebo>

  <!-- ros_control bridge -->
  <gazebo>
    <plugin name="gazebo_ros_control" filename="libgazebo_ros_control.so">
      <robotNamespace>/farmbeast</robotNamespace>
      <robotSimType>gazebo_ros_control/DefaultRobotHWSim</robotSimType>
    </plugin>
  </gazebo>

</robot>